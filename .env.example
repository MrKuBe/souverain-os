# ---------------------------------------------------------------------------
# SouverainOS — exemple de configuration
# Copier ce fichier en `.env` puis remplacer TOUS les secrets avant déploiement.
# Ne jamais versionner le fichier `.env` réel.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
# En production, l'API refuse de démarrer avec la valeur d'exemple.
SECRET_KEY=change-me-with-a-long-random-secret-before-any-real-use
API_PREFIX=/api
LOG_LEVEL=INFO

# Origines autorisées pour le frontend (séparées par des virgules).
CORS_ORIGINS=http://localhost:3000
# Hôtes acceptés par l'API (séparés par des virgules).
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1

# --- PostgreSQL 16 ----------------------------------------------------------
POSTGRES_DB=souverainos
POSTGRES_USER=souverainos
POSTGRES_PASSWORD=change-me-database-password
# Utilisé en exécution locale hors conteneur ; compose.yaml reconstruit cette URL.
DATABASE_URL=postgresql+psycopg://souverainos:change-me-database-password@localhost:5432/souverainos

# --- Initialisation ---------------------------------------------------------
# Crée les tables et le jeu de démonstration au démarrage (idempotent).
SEED_ON_STARTUP=true
SEED_DEMO_DATA=true

# Compte administrateur local initial (créé une seule fois, jamais écrasé).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password-12-caracteres-minimum
ADMIN_EMAIL=admin@souverainos.local
ADMIN_FULL_NAME=Administrateur SouverainOS

# --- Authentification -------------------------------------------------------
# local | ldap | hybrid
AUTH_MODE=hybrid
AUTH_ALLOW_LDAP_FALLBACK=true
# Rôle attribué à un utilisateur LDAP sans groupe reconnu.
LDAP_DEFAULT_ROLE=lecteur_direction

# JWT : HS256 par défaut. Pour RS256, renseigner les deux chemins PEM.
JWT_ALGORITHM=HS256
JWT_ISSUER=souverainos
JWT_AUDIENCE=souverainos-web
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cookies : COOKIE_SECURE doit être true en production HTTPS.
COOKIE_SECURE=false

# --- Annuaire LDAP / Active Directory / FreeIPA -----------------------------
# Exemples :
#   ldap://ldap.example.local:389
#   ldaps://ad.example.local:636
LDAP_SERVER_URL=
LDAP_USE_SSL=false
LDAP_TLS_VALIDATE=true
# Chemin vers le CA interne si nécessaire (PEM).
LDAP_CA_CERT_FILE=
LDAP_BASE_DN=dc=example,dc=local
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# {username} est échappé contre l'injection LDAP avant substitution.
LDAP_USER_FILTER=(uid={username})
# Active Directory : (sAMAccountName={username})
LDAP_ATTRIBUTE_UID=uid
LDAP_ATTRIBUTE_EMAIL=mail
LDAP_ATTRIBUTE_DISPLAY_NAME=cn
LDAP_ATTRIBUTE_MEMBEROF=memberOf
LDAP_ADMIN_GROUP_DN=
LDAP_AUDITEUR_GROUP_DN=
LDAP_LECTEUR_GROUP_DN=
LDAP_TIMEOUT_SECONDS=8

# --- Import Mercator --------------------------------------------------------
# Laisser true en production. false uniquement pour un CA interne maîtrisé.
MERCATOR_VERIFY_TLS=true
MERCATOR_TIMEOUT_SECONDS=20
MAX_IMPORT_ROWS=5000
